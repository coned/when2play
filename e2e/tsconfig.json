{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "DOM"],
		"module": "es2022",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["./**/*.ts", "../playwright.config.ts"]
}
